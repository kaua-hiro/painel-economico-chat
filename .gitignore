# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# banco local (SQLite)
/prisma/*.db
/prisma/*.db-journal

# diretorio local de uma ferramenta especifica: a skill versionada do projeto
# fica em .agents/skills (local universal, lido por qualquer agente) e o
# .claude/skills e apenas um symlink gerado na maquina de quem instalou
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
