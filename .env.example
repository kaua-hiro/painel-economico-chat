# Banco local do chat (SQLite via Prisma)
DATABASE_URL="file:./dev.db"

# Porta do servidor Node que hospeda o Next.js + Socket.IO
PORT=3000

# Origens aceitas no handshake do WebSocket (separadas por vírgula).
# Obrigatório em produção: o servidor recusa subir sem esta variável.
# Em desenvolvimento, o localhost da porta acima é liberado automaticamente.
ALLOWED_ORIGINS="https://seu-dominio.com.br"

# Opcional. Sem esta chave o assistente @bcb responde pelo motor determinístico,
# que usa as mesmas séries do Banco Central. Com ela, as respostas passam a vir
# da Claude API (modelo claude-opus-5), ainda restritas aos dados do painel.
# ANTHROPIC_API_KEY="sk-ant-..."
